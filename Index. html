  <script src="/_sdk/5629ea66dc55d54f.editing_sdk.js" integrity="sha512-snPYzGvgiTEMUBOb+HlCBkFeiM0IRX4hcgA78wvalhC0WnJtaX+RCbosPWtNqZsZ7sZ9NwN0oePZYa+IlMwa+w=="></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();

      const cards = [...document.querySelectorAll(".quiz-card")];
      const dots = [...document.querySelectorAll(".dot")];
      const previousButton = document.getElementById("previous-button");
      const nextButton = document.getElementById("next-button");
      const quizNavigation = document.getElementById("quiz-navigation");
      const resultScreen = document.getElementById("result-screen");
      const progressBar = document.getElementById("progress-bar");
      const counterValue = document.getElementById("counter-value");
      const scoreValue = document.getElementById("score-value");
      const resultMessage = document.getElementById("result-message");
      const restartButton = document.getElementById("restart-button");

      let currentQuestion = 0;
      const answers = Array(10).fill(null);

      function updateView() {
        cards.forEach((card, index) => card.classList.toggle("active", index === currentQuestion));
        dots.forEach((dot, index) => {
          dot.classList.toggle("current", index === currentQuestion);
          dot.classList.toggle("done", answers[index] !== null && index !== currentQuestion);
        });
        counterValue.textContent = `${currentQuestion + 1} / 10`;
        progressBar.style.width = `${(currentQuestion + 1) * 10}%`;
        previousButton.disabled = currentQuestion === 0;
        nextButton.disabled = answers[currentQuestion] === null;
        quizNavigation.classList.remove("hidden");
      }

      function selectAnswer(button) {
        const card = button.closest(".quiz-card");
        const questionIndex = Number(card.dataset.question);
        if (answers[questionIndex] !== null) return;

        const selectedChoice = Number(button.dataset.choice);
        const correctChoice = Number(card.dataset.answer);
        answers[questionIndex] = selectedChoice;

        card.querySelectorAll(".answer-option").forEach(option => {
          option.disabled = true;
          const choice = Number(option.dataset.choice);
          if (choice === correctChoice) option.classList.add("correct");
          if (choice === selectedChoice && choice !== correctChoice) option.classList.add("incorrect");
          if (choice === selectedChoice) option.classList.add("selected");
        });

        const feedbackPanels = card.querySelectorAll(".feedback");
        feedbackPanels[selectedChoice === correctChoice ? 0 : 1].classList.add("show");
        nextButton.disabled = false;
        dots[questionIndex].classList.add("done");
      }

      cards.forEach(card => {
        card.querySelectorAll(".answer-option").forEach(button => {
          button.addEventListener("click", () => selectAnswer(button));
        });
      });

      previousButton.addEventListener("click", () => {
        if (currentQuestion > 0) {
          currentQuestion--;
          updateView();
        }
      });

      nextButton.addEventListener("click", () => {
        if (answers[currentQuestion] === null) return;
        if (currentQuestion < cards.length - 1) {
          currentQuestion++;
          updateView();
        } else {
          showResults();
        }
      });

      function showResults() {
        const score = answers.reduce((total, answer, index) => {
          return total + (answer === Number(cards[index].dataset.answer) ? 1 : 0);
        }, 0);

        cards.forEach(card => card.classList.remove("active"));
        quizNavigation.classList.add("hidden");
        resultScreen.classList.add("show");
        progressBar.style.width = "100%";
        scoreValue.textContent = `${score} / 10`;

        if (score >= 9) {
          resultMessage.textContent = "Luar biasa! Kamu sudah sangat memahami penggunaan kata hubung.";
        } else if (score >= 7) {
          resultMessage.textContent = "Bagus sekali! Terus berlatih agar pemahamanmu semakin kuat.";
        } else {
          resultMessage.textContent = "Tetap semangat! Ulangi kuis ini untuk menguatkan pemahamanmu.";
        }
      }

      restartButton.addEventListener("click", () => {
        answers.fill(null);
        currentQuestion = 0;
        resultScreen.classList.remove("show");
        cards.forEach(card => {
          card.querySelectorAll(".answer-option").forEach(option => {
            option.disabled = false;
            option.classList.remove("selected", "correct", "incorrect");
          });
          card.querySelectorAll(".feedback").forEach(panel => panel.classList.remove("show"));
        });
        updateView();
      });

      updateView();
    });
  </script>
